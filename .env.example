# Copy to .env and fill in. Never commit .env.
# Any platform left without credentials is reported as "failed: not configured".

# ---------- General ----------
HTTP_TIMEOUT_SECONDS=15
TIMEZONE=UTC                      # IANA name, e.g. Asia/Kolkata
VERIFY_PUBLIC_ACCESS=true         # fetch each post anonymously to confirm it is public
PUBLIC_CHECK_TIMEOUT_SECONDS=8

# ---------- LLM enrichment (title + hashtags; message is never changed) ----------
LLM_ENABLED=true
LLM_PROVIDERS=gemini,ollama       # tried in order; plain message if all fail

# Google Gemini — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=10

# Ollama (local) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=10m

# ---------- Platforms ----------
# Mastodon — Preferences → Development → New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=public
MASTODON_LANGUAGE=en
MASTODON_MAX_CHARACTERS=500

# Bluesky — Settings → Privacy and security → App passwords
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_LANGUAGE=en
BLUESKY_LINK_CARD=true

# Telegram — token from @BotFather; bot must be admin of the public channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel
TELEGRAM_INCLUDE_TITLE=true

# GitHub Gist — fine-grained PAT with "Gists: Read and write" (or classic `gist` scope)
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# DEV Community — https://dev.to/settings/extensions
DEVTO_API_KEY=
